# Lines to change in dietpi.txt (boot partition) BEFORE the first boot,
# for a hands-off install. Everything else can stay at the default.
# Values here are for this project; adjust password, timezone and hostname.

AUTO_SETUP_AUTOMATED=1
AUTO_SETUP_GLOBAL_PASSWORD=change-me-now
AUTO_SETUP_TIMEZONE=America/New_York
AUTO_SETUP_LOCALE=en_US.UTF-8
AUTO_SETUP_KEYBOARD_LAYOUT=us
# Give each board its own hostname when flashing several
AUTO_SETUP_NET_HOSTNAME=odroid-kiosk

# Network: easiest is to boot on Ethernet and answer the Wi-Fi questions in
# `odroid-ha-install --configure` (password stored only as the derived key).
# Fully hands-off Wi-Fi: set WIFI_ENABLED=1, put the SSID + key in
# dietpi-wifi.txt (aWIFI_SSID[0]= / aWIFI_KEY[0]=), and set the same
# WIFI_SSID in /boot/odroid-ha.conf. install.sh converts the key to the
# derived form; blank aWIFI_KEY in dietpi-wifi.txt once the board is online.
AUTO_SETUP_NET_ETHERNET_ENABLED=1
AUTO_SETUP_NET_WIFI_ENABLED=0
AUTO_SETUP_NET_WIFI_COUNTRY_CODE=US

# Keep DietPi's own autostart on console. install.sh sets up the kiosk itself.
AUTO_SETUP_AUTOSTART_TARGET_INDEX=0

# Run our installer at the end of first boot (repo must be public for the URL form)
AUTO_SETUP_CUSTOM_SCRIPT_EXEC=https://raw.githubusercontent.com/A7QG59F2/ODroid-C2-bluetooth-proxy/main/dietpi/Automation_Custom_Script.sh

SURVEY_OPTED_IN=0

# Odroid C2 – Home Assistant Bluetooth proxy + kiosk
# Live copy: /etc/odroid-ha/odroid-ha.conf. A first install run from a terminal
# asks which parts this board has and fills it in; ask again any time with
#     sudo odroid-ha-install --configure
# or edit it by hand and re-run  sudo ./install.sh
# For a hands-off install, put an edited copy on the boot partition as
# /boot/odroid-ha.conf (no questions are asked without a terminal).
#
# Each ENABLE_* switch can be turned off for boards without that part;
# re-running the installer removes what a switched-off part had set up.
#
# Lines are plain shell assignments: KEY="value"  (no spaces around '=')

# ─── Home Assistant ─────────────────────────────────────────────────────────
# Full URL of the dashboard the kiosk should open.
# Tip: a dedicated light-weight dashboard works best on the C2's GPU.
HA_URL="http://homeassistant.local:8123/lovelace/0"

# ─── System ─────────────────────────────────────────────────────────────────
# Local time zone, a name under /usr/share/zoneinfo such as
# "America/Indiana/Indianapolis". The JVC radio's clock is set from this board,
# so it must be right. Empty = keep the system's zone (DietPi sets it on first
# boot from AUTO_SETUP_TIMEZONE). --configure asks for it.
TIMEZONE=""

# ─── Bluetooth proxy (denvera/bt-proxy) ─────────────────────────────────────
ENABLE_BT_PROXY="1"
# Name shown in Home Assistant (lowercase, letters/numbers/dashes). Must be
# unique per board. Empty = odroid-c2-<last 4 hex of the Ethernet MAC>.
BT_PROXY_NAME=""
# Empty = "Odroid C2 Bluetooth Proxy <same 4 hex>"
BT_PROXY_FRIENDLY_NAME=""
# The C2 has no built-in Bluetooth, so the TP-Link UB500 is hci0.
BT_ADAPTER="hci0"
# Max simultaneous active BLE connections handled for HA
BT_MAX_CONNECTIONS="3"
BT_PROXY_LOG_LEVEL="INFO"

# ─── Kiosk (Chromium on X, MAGEX 10.1" touch screen) ────────────────────────
ENABLE_KIOSK="1"
# Linux user that auto-logs in on tty1 and runs the kiosk
KIOSK_USER="kiosk"
# Screen rotation: normal | left | right | inverted   (touch follows automatically)
SCREEN_ROTATION="normal"
# Force a mode if auto-detect picks the wrong one, e.g. "1920x1200" (the panel's native mode). Empty = auto.
SCREEN_MODE=""
# Keep the screen on (1) or let it blank after SCREEN_BLANK_SECONDS (0)
SCREEN_ALWAYS_ON="1"
SCREEN_BLANK_SECONDS="600"
# Hide the mouse cursor (touch screen)
HIDE_CURSOR="1"
# Chromium page zoom (1.0 = 100%). 1.25 makes a 1920x1200 panel readable at 10".
CHROMIUM_ZOOM="1.0"
# Extra Chromium flags. If you get a blank/white window, add: --disable-gpu
CHROMIUM_EXTRA_FLAGS=""

# ─── On-screen keyboard (Onboard) ───────────────────────────────────────────
# Pops up by itself when a text field in Home Assistant is tapped, and hides
# again when it loses focus.
ONSCREEN_KEYBOARD="1"
# Layout name: Compact | Small | Phone | "Full Keyboard" | Grid | Whiteboard
OSK_LAYOUT="Compact"
# Theme name: Droid | Nightshade | Blackboard | Charcoal | ModelM | HighContrast
OSK_THEME="Droid"
# Dock the keyboard at the bottom (or top) edge of the screen
OSK_EDGE="bottom"
# Small floating button that opens the keyboard by hand, for any field
# where auto-show doesn't fire. 1 = show it, 0 = hidden (default).
OSK_FLOATING_BUTTON="0"
# How Onboard reads touches: none (touch acts as a mouse; most compatible),
# single, or multi. If keys register twice or not at all, try another one.
OSK_TOUCH_INPUT="none"

# ─── Wi-Fi (TL-WN821N, Ralink RT5572, dual-band) ────────────────────────────
ENABLE_WIFI="1"
# Network to join. Empty = install the driver only and leave networking alone.
# The password is never stored here: --configure asks for it and saves only
# the derived WPA key in /etc/wpa_supplicant/wpa_supplicant.conf. (A network
# set up through dietpi-config is picked up and converted the same way.)
WIFI_SSID=""
WIFI_COUNTRY="US"
# Use only the 5 GHz band, so Wi-Fi doesn't fight the Bluetooth dongle on 2.4 GHz
WIFI_5GHZ_ONLY="1"
WIFI_DISABLE_POWERSAVE="1"

# ─── JVC KD-SX38MBT (Bluetooth Classic / SPP) ───────────────────────────────
# Installs the probe tool in /opt/odroid-ha/jvc. The MQTT bridge comes later,
# once the JVC Remote command bytes have been captured. Needs the UB500.
ENABLE_JVC_TOOLS="0"
JVC_MAC="88:E0:34:B7:98:6C"
# RFCOMM channel of the JVC Remote (SPP) service. Found with jvc-probe.py scan/listen.
JVC_CHANNEL="16"
